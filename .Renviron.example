# Copy this file to .Renviron (in the repository root or your home directory)
# and restart R. .Renviron is git-ignored.
#
# Only the AI insights panel needs these; every other feature works without a
# key.

# Required to enable the AI insights panels.
OPENAI_API_KEY=sk-your-key-here

# Optional. Overrides the default model (gpt-5.6-luna).
# Current options: gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol
# OPENAI_MODEL=gpt-5.6-terra

# Optional. Point the apps at an Azure/proxy/compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1
